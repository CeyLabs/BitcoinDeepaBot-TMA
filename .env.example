# Copy to .env.local and fill in: cp .env.example .env.local
# NEXT_PUBLIC_* values are baked into the client bundle at build time — never
# put secrets in them.

# BitcoinDeepa-DCA-BE backend, called directly from the browser (CORS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Telegram bot that hosts the Mini App (used for t.me links and invites).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BitcoinDeepaBot

# Client ID for Telegram Login (browser sign-in), from @BotFather -> bot -> Login Widget.
# Public identifier, not a secret.
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=

# Google Analytics measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Server-only: MongoDB used by src/app/api/user (landing user count).
MONGODB_URI=
