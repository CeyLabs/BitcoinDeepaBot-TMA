# Copy to .env.local and fill in: cp .env.example .env.local
# NEXT_PUBLIC_* values are baked into the client bundle at build time — never
# put secrets in them.

# BitcoinDeepa-DCA-BE backend, called directly from the browser with credentials
# (the backend's APP_URL must be this app's origin). Prod: app. and api.bitcoindeepa.com
# share a site. Dev on two sites (vercel.app + railway.app): set APP_COOKIE_SAME_SITE=none
# on the backend for web login (Safari/iOS still block it; the Mini App isn't affected).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Telegram bot that hosts the Mini App (used for t.me links and invites).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BitcoinDeepaBot

# Google Analytics measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Server-only: MongoDB used by src/app/api/user (landing user count).
MONGODB_URI=
